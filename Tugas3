<body>
  <div class="card">
    <form action="#sukses" method="get">
      <div class="main">
        <div class="head">
          <div class="badge"><i class="fa fa-shopping-bag"></i></div>
          <h1>Formulir Pemesanan Produk</h1>
          <p>Lengkapi data pesananmu. Total harga dan ongkos kirim terhitung otomatis di ringkasan.</p>
        </div>

        <div class="sec">
          <h2><b>1</b>Data pemesan</h2>
          <div class="field">
            <label for="nama" class="req">Nama lengkap</label>
            <div class="input"><i class="fa fa-address-card"></i>
              <input id="nama" name="nama" type="text" placeholder="Nama sesuai identitas" required minlength="3" autocomplete="name">
            </div>
            <p class="error">Nama minimal 3 huruf.</p>
          </div>
          <div class="grid">
            <div class="field">
              <label for="wa" class="req">Nomor WhatsApp/HP</label>
              <div class="input"><i class="fa fa-phone-square"></i>
                <input id="wa" name="wa" type="tel" placeholder="08xxxxxxxxxx" required pattern="08[0-9]{8,12}" autocomplete="tel">
              </div>
              <p class="error">Format nomor: 08xxxxxxxxxx.</p>
            </div>
            <div class="field">
              <label for="email" class="req">Gmail</label>
              <div class="input"><i class="fa fa-envelope"></i>
                <input id="email" name="email" type="email" placeholder="nama@gmail.com" required pattern="[a-zA-Z0-9._%+\-]+@gmail\.com" autocomplete="email">
              </div>
              <p class="error">Gunakan alamat Gmail yang valid.</p>
            </div>
          </div>
        </div>

        <div class="sec">
          <h2><b>2</b>Produk</h2>
          <div class="field">
            <label for="produk" class="req">Nama produk</label>
            <div class="input"><i class="fa fa-edit"></i>
              <input id="produk" name="produk" type="text" placeholder="Contoh: Paket kebersihan bulanan" required>
            </div>
          </div>
          <div class="field">
            <span class="label req">Varian</span>
            <div class="vgrid">
              <div><input type="radio" name="varian" id="v1" value="Rinso" checked><label for="v1"><strong>Rinso</strong><span>Rp 18.000</span><small>900 g per pcs</small></label></div>
              <div><input type="radio" name="varian" id="v2" value="Close Up"><label for="v2"><strong>Close Up</strong><span>Rp 12.000</span><small>160 g per pcs</small></label></div>
              <div><input type="radio" name="varian" id="v3" value="Pepsodent"><label for="v3"><strong>Pepsodent</strong><span>Rp 10.000</span><small>190 g per pcs</small></label></div>
            </div>
          </div>
          <div class="field">
            <label for="jml">Jumlah <small>(maksimal 10 per pesanan)</small></label>
            <select id="jml" name="jumlah">
              <option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option>
              <option value="6">6</option><option value="7">7</option><option value="8">8</option><option value="9">9</option><option value="10">10</option>
            </select>
          </div>
        </div>

        <div class="sec">
          <h2><b>3</b>Pengiriman</h2>
          <div class="field">
            <label for="alamat" class="req">Alamat lengkap</label>
            <div class="input"><i class="fa fa-location-arrow"></i>
              <input id="alamat" name="alamat" type="text" placeholder="Jalan, nomor, RT/RW, kelurahan, kecamatan, kode pos" required minlength="10">
            </div>
            <p class="error">Tulis alamat selengkapnya (minimal 10 karakter).</p>
          </div>
          <div class="grid">
            <div class="field">
              <label for="lok">Wilayah tujuan <small>(menentukan tarif per kg)</small></label>
              <select id="lok" name="wilayah">
                <option value="1">Jawa Timur</option>
                <option value="2">Pulau Jawa lainnya</option>
                <option value="3">Luar Pulau Jawa</option>
              </select>
            </div>
            <div class="field">
              <label for="kurir">Kurir/ekspedisi</label>
              <select id="kurir" name="kurir">
                <option value="1">JNE</option><option value="2">J&amp;T</option><option value="3">SiCepat</option><option value="4">Paxel</option>
                <option value="5">GoSend / Grab / ShopeeExpress Instant</option>
              </select>
            </div>
          </div>
          <div class="field">
            <span class="label">Jenis layanan</span>
            <div class="options">
              <div class="option"><input type="radio" name="layanan" id="ly1" value="Reguler" checked><label for="ly1">Reguler</label></div>
              <div class="option"><input type="radio" name="layanan" id="ly2" value="Same Day"><label for="ly2">Same Day</label></div>
              <div class="option"><input type="radio" name="layanan" id="ly3" value="Instant"><label for="ly3">Instant</label></div>
              <div class="option"><input type="radio" name="layanan" id="ly4" value="Cargo"><label for="ly4">Cargo</label></div>
            </div>
            <p class="hint eta-hint"><i class="fa fa-truck"></i><span class="est"></span></p>
          </div>
          <div class="field">
            <label class="switch">
              <span class="sw-text"><i class="fa fa-gift"></i><span>Kirim ke penerima lain (hadiah/dropship)<small>Isi nama dan nomor penerima jika berbeda dengan pemesan</small></span></span>
              <input type="checkbox" id="hadiah" name="hadiah" value="ya">
              <span class="track"></span>
            </label>
          </div>
          <div class="grid penerima">
            <div class="field">
              <label for="p_nama">Nama penerima</label>
              <div class="input"><i class="fa fa-user"></i>
                <input id="p_nama" name="p_nama" type="text" placeholder="Nama penerima paket">
              </div>
            </div>
            <div class="field">
              <label for="p_hp">Nomor HP penerima</label>
              <div class="input"><i class="fa fa-phone"></i>
                <input id="p_hp" name="p_hp" type="tel" placeholder="08xxxxxxxxxx" pattern="08[0-9]{8,12}">
              </div>
              <p class="error">Format nomor: 08xxxxxxxxxx.</p>
            </div>
          </div>
        </div>

        <div class="sec">
          <h2><b>4</b>Pembayaran</h2>
          <div class="field">
            <span class="label req">Metode pembayaran</span>
            <div class="options">
              <div class="option"><input type="radio" name="bayar" id="b1" value="Transfer Bank" required><label for="b1">Transfer Bank (BCA, Mandiri, dll.)</label></div>
              <div class="option"><input type="radio" name="bayar" id="b2" value="Gopay"><label for="b2">Gopay</label></div>
              <div class="option"><input type="radio" name="bayar" id="b3" value="OVO"><label for="b3">OVO</label></div>
              <div class="option"><input type="radio" name="bayar" id="b4" value="ShopeePay"><label for="b4">ShopeePay</label></div>
              <div class="option"><input type="radio" name="bayar" id="b5" value="Dana"><label for="b5">Dana</label></div>
              <div class="option"><input type="radio" name="bayar" id="b6" value="QRIS"><label for="b6">QRIS</label></div>
              <div class="option"><input type="radio" name="bayar" id="b7" value="COD"><label for="b7">COD</label></div>
            </div>
          </div>
          <div class="field bank">
            <span class="label">Pilih bank tujuan transfer</span>
            <div class="vgrid">
              <div><input type="radio" name="bank" id="bk1" value="BCA" checked><label for="bk1"><strong>BCA</strong><small>Bank Central Asia</small></label></div>
              <div><input type="radio" name="bank" id="bk2" value="Mandiri"><label for="bk2"><strong>Mandiri</strong><small>Bank Mandiri</small></label></div>
              <div><input type="radio" name="bank" id="bk3" value="BNI"><label for="bk3"><strong>BNI</strong><small>Bank Negara Indonesia</small></label></div>
              <div><input type="radio" name="bank" id="bk4" value="BRI"><label for="bk4"><strong>BRI</strong><small>Bank Rakyat Indonesia</small></label></div>
              <div><input type="radio" name="bank" id="bk5" value="BSI"><label for="bk5"><strong>BSI</strong><small>Bank Syariah Indonesia</small></label></div>
              <div><input type="radio" name="bank" id="bk6" value="CIMB Niaga"><label for="bk6"><strong>CIMB Niaga</strong><small>Bank CIMB Niaga</small></label></div>
            </div>
          </div>
          <div class="field">
            <label for="vc">Voucher</label>
            <select id="vc" name="voucher">
              <option value="1">Tanpa voucher</option>
              <option value="2">HEMAT10 – diskon 10% harga produk</option>
              <option value="3">ONGKIR10 – potongan ongkos kirim Rp 10.000</option>
            </select>
          </div>
          <div class="field upload">
            <label for="struk">Upload struk/screenshot pembayaran</label>
            <input id="struk" name="struk" type="file" accept="image/*,.pdf">
            <p class="hint">Unggah bukti setelah membayar sesuai Grand Total. Tidak perlu untuk COD.</p>
          </div>
          <div class="field">
            <label for="note">Note <small>(opsional)</small></label>
            <textarea id="note" name="note" rows="5" placeholder="Pesan untuk penjual atau kurir"></textarea>
          </div>
        </div>
        <label class="agree">
          <input type="checkbox" id="setuju" name="setuju" required>
          <span>Saya memastikan data pesanan sudah benar dan setuju dengan ketentuan pemesanan.</span>
        </label>
      </div>

      <aside class="sum" aria-label="Ringkasan pesanan">
        <div class="sum-body">
        <h2>Ringkasan pesanan</h2>
        <p class="item"></p>
        <div class="stok">
          <div class="top"><span>Sisa stok</span><b>100 produk</b></div>
          <div class="bar"><i></i></div>
          <small class="after"></small>
        </div>
        <div class="eta">
          <i class="fa fa-truck"></i>
          <div><span>Estimasi tiba</span><b class="est"></b><small>Dihitung sejak paket diserahkan ke kurir, tanpa hari libur.</small></div>
        </div>
        <dl class="rows">
          <div><dt>Total harga produk</dt><dd class="tot"></dd></div>
          <div><dt>Ongkos kirim<small class="ber"></small></dt><dd class="ong"></dd></div>
          <div><dt>Potongan voucher</dt><dd class="disc"></dd></div>
          <div><dt>Kode unik</dt><dd class="ku"></dd></div>
        </dl>
        <div class="pay"><span>Cara bayar</span><b class="rekv"></b></div>
        <p class="note">
          <span class="nn">Transfer tepat sesuai Grand total, termasuk kode unik, supaya pembayaran mudah dicek.</span>
          <span class="nc">Bayar tunai ke kurir saat barang tiba. COD tidak memakai kode unik.</span>
        </p>
        </div>
        <div class="gt"><span>Grand total</span><strong class="gtv"></strong></div>
        <div class="actions">
          <button type="reset" class="btn btn-reset"><i class="fa fa-refresh"></i>Ulangi</button>
          <button type="submit" class="btn btn-send"><i class="fa fa-paper-plane"></i>Kirim pesanan</button>
        </div>
      </aside>
    </form>
  </div>

  <!-- Ganti 6281234567890 dengan nomor WhatsApp admin (awali 62, tanpa 0 dan tanpa +) -->
  <a class="wa-float" href="https://wa.me/6281234567890?text=Halo%20admin%2C%20saya%20ingin%20bertanya%20soal%20pesanan%20saya." target="_blank" rel="noopener" aria-label="Hubungi admin lewat WhatsApp">
    <i class="fa fa-whatsapp"></i><span>Hubungi admin</span>
  </a>

  <div class="modal" id="sukses" role="dialog" aria-labelledby="judul-sukses">
    <div class="box">
      <div class="ok"><i class="fa fa-check"></i></div>
      <h2 id="judul-sukses">Pesanan terkirim</h2>
      <p>Terima kasih. Selesaikan pembayaran sesuai Grand total, lalu unggah bukti pembayaran jika belum.</p>
      <a href="#">Tutup</a>
    </div>
  </div>
</body>
</html>

    form:has(#v2:checked):has(#jml [value="4"]:checked){--item:"4 × Close Up";--tot:"Rp 48.000"}
    form:has(#v2:checked):has(#jml [value="5"]:checked){--item:"5 × Close Up";--tot:"Rp 60.000"}
    form:has(#v2:checked):has(#jml [value="6"]:checked){--item:"6 × Close Up";--tot:"Rp 72.000"}
    form:has(#v2:checked):has(#jml [value="7"]:checked){--item:"7 × Close Up";--tot:"Rp 84.000"}
    form:has(#v2:checked):has(#jml [value="8"]:checked){--item:"8 × Close Up";--tot:"Rp 96.000"}
    form:has(#v2:checked):has(#jml [value="9"]:checked){--item:"9 × Close Up";--tot:"Rp 108.000"}
    form:has(#v2:checked):has(#jml [value="10"]:checked){--item:"10 × Close Up";--tot:"Rp 120.000"}
    form:has(#v3:checked):has(#jml [value="1"]:checked){--item:"1 × Pepsodent";--tot:"Rp 10.000"}
    form:has(#v3:checked):has(#jml [value="2"]:checked){--item:"2 × Pepsodent";--tot:"Rp 20.000"}
    form:has(#v3:checked):has(#jml [value="3"]:checked){--item:"3 × Pepsodent";--tot:"Rp 30.000"}
    form:has(#v3:checked):has(#jml [value="4"]:checked){--item:"4 × Pepsodent";--tot:"Rp 40.000"}
    form:has(#v3:checked):has(#jml [value="5"]:checked){--item:"5 × Pepsodent";--tot:"Rp 50.000"}
    form:has(#v3:checked):has(#jml [value="6"]:checked){--item:"6 × Pepsodent";--tot:"Rp 60.000"}
    form:has(#v3:checked):has(#jml [value="7"]:checked){--item:"7 × Pepsodent";--tot:"Rp 70.000"}
    form:has(#v3:checked):has(#jml [value="8"]:checked){--item:"8 × Pepsodent";--tot:"Rp 80.000"}

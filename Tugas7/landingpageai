<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PeTIK Jombang | Pendidikan TIK dengan Bekal Kepesantrenan</title>
<meta name="description" content="Lembaga pendidikan vokasi Teknologi Informasi dan Komunikasi di bawah naungan Yayasan Baitul Maal PLN, dengan pembelajaran kepesantrenan.">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --indigo:#3b0764;--navy:#172554;--royal:#1e3a8a;
  --emas:#d4a017;--emas-terang:#f5c542;
  --bg:#f5f6fa;--teks:#1e293b;--lembut:#5b6577;--garis:#e3e6ee;
  --bayangan:0 1px 2px rgba(23,37,84,.06),0 10px 28px rgba(23,37,84,.08);
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;font-family:'Poppins',sans-serif;background:var(--bg);color:var(--teks);line-height:1.7}
a{color:inherit}
img,svg{max-width:100%}
:focus-visible{outline:3px solid var(--emas-terang);outline-offset:3px;border-radius:6px}
.wrap{max-width:1160px;margin:auto;padding:0 24px}
h1,h2,h3{font-family:'Playfair Display',serif;line-height:1.2;margin:0}

/* Tombol */
.btn{display:inline-flex;align-items:center;gap:10px;padding:13px 28px;border-radius:999px;text-decoration:none;font-weight:600;font-size:15px;border:0;cursor:pointer;transition:transform .2s,box-shadow .2s,background .2s}
.btn-emas{background:linear-gradient(135deg,var(--emas),var(--emas-terang));color:var(--navy);box-shadow:0 8px 20px rgba(212,160,23,.35)}
.btn-emas:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(212,160,23,.45)}
.btn-garis{border:1.5px solid rgba(255,255,255,.4);color:#fff}
.btn-garis:hover{background:rgba(255,255,255,.12)}

/* Header */
header{position:sticky;top:0;z-index:50;background:rgba(23,37,84,.93);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid rgba(255,255,255,.08)}
.bar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 24px;max-width:1160px;margin:auto}
.logo{display:flex;align-items:center;gap:12px;color:#fff;text-decoration:none;font-family:'Playfair Display',serif;font-size:21px;font-weight:700}
.logo img{width:44px;height:44px;border-radius:50%;object-fit:cover;background:#fff;flex:none;box-shadow:0 0 0 2px rgba(255,255,255,.25)}
nav ul{display:flex;gap:4px;list-style:none;margin:0;padding:0;align-items:center}
nav a{color:#dbe3f5;text-decoration:none;font-size:14px;font-weight:500;padding:8px 15px;border-radius:999px;transition:background .25s,color .25s}
nav a:hover{background:rgba(255,255,255,.12);color:#fff}
nav a.daftar{background:linear-gradient(135deg,var(--emas),var(--emas-terang));color:var(--navy);font-weight:600;margin-left:8px}
nav a.daftar:hover{background:linear-gradient(135deg,var(--emas),var(--emas-terang));filter:brightness(1.05)}
.burger{display:none;background:none;border:0;color:#fff;font-size:22px;cursor:pointer;padding:6px 10px}

/* Hero */
.hero{position:relative;overflow:hidden;color:#fff;padding:96px 0 150px;background:radial-gradient(900px 420px at 90% -10%,rgba(212,160,23,.25),transparent 60%),linear-gradient(135deg,var(--navy),var(--indigo))}
.hero::after{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.07) 1px,transparent 1px);background-size:26px 26px;pointer-events:none}
.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr .8fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(34px,5vw,58px);font-weight:700;margin-bottom:22px}
.hero p{color:#cfd8ee;font-weight:300;font-size:17px;max-width:540px;margin:0 0 34px}
.tombol{display:flex;gap:14px;flex-wrap:wrap}
.panel{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.16);border-radius:22px;padding:14px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.panel div{display:flex;align-items:center;gap:16px;padding:18px;border-radius:14px}
.panel div+div{border-top:1px solid rgba(255,255,255,.1)}
.panel i{width:48px;height:48px;border-radius:13px;display:grid;place-items:center;flex:none;background:linear-gradient(135deg,var(--emas),var(--emas-terang));color:var(--navy);font-size:20px}
.panel b{display:block;font-weight:600;font-size:16px}
.panel span{font-size:13.5px;color:#cfd8ee;font-weight:300;line-height:1.5;display:block}

/* Statistik */
.stat{margin-top:-70px;position:relative;z-index:2}
.stat .wrap>div{background:#fff;border-radius:20px;box-shadow:var(--bayangan);border:1px solid var(--garis);display:grid;grid-template-columns:repeat(4,1fr);padding:30px 10px}
.stat article{text-align:center;padding:4px 14px}
.stat article+article{border-left:1px solid var(--garis)}
.stat strong{display:block;font-family:'Playfair Display',serif;font-size:32px;color:var(--indigo);line-height:1.2}
.stat span{font-size:13.5px;color:var(--lembut)}

/* Section umum */
section{padding:96px 0}
.judul{max-width:640px;margin-bottom:48px}
.judul.tengah{margin-left:auto;margin-right:auto;text-align:center}
.judul h2{font-size:clamp(28px,3.4vw,40px);color:var(--navy);margin-bottom:14px}
.judul::after{content:"";display:block;width:56px;height:4px;border-radius:4px;margin-top:18px;background:linear-gradient(90deg,var(--emas),var(--emas-terang))}
.judul.tengah::after{margin-left:auto;margin-right:auto}
.judul p{color:var(--lembut);margin:0}

/* Tentang */
.tentang .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:start}
.tentang p{color:var(--lembut);margin:0 0 18px}
.nilai{display:grid;gap:16px}
.nilai div{display:flex;gap:16px;background:#fff;border:1px solid var(--garis);border-radius:16px;padding:22px;box-shadow:var(--bayangan)}
.nilai i{color:var(--emas);font-size:22px;margin-top:4px;flex:none;width:26px;text-align:center}
.nilai b{display:block;color:var(--navy);font-weight:600}
.nilai span{font-size:14px;color:var(--lembut);line-height:1.6;display:block}

/* Jurusan */
.jurusan{background:#fff}
.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:28px}
.jcard{border-radius:20px;border:1px solid var(--garis);padding:38px;background:linear-gradient(180deg,#fff,#f8f9fd);transition:border-color .25s,box-shadow .25s}
.jcard:hover{border-color:var(--emas);box-shadow:0 14px 34px rgba(23,37,84,.12)}
.jcard .ikon{width:58px;height:58px;border-radius:16px;display:grid;place-items:center;background:linear-gradient(135deg,var(--navy),var(--indigo));color:var(--emas-terang);font-size:24px;margin-bottom:20px}
.jcard h3{font-size:24px;color:var(--navy)}
.jcard small{display:block;color:var(--emas);font-weight:600;margin:4px 0 18px}
.jcard ul{list-style:none;margin:0;padding:0}
.jcard li{position:relative;padding-left:26px;color:var(--lembut);margin-bottom:9px;font-size:15px}
.jcard li::before{content:"\f00c";font-family:"Font Awesome 6 Free";font-weight:900;font-size:12px;color:var(--emas);position:absolute;left:0;top:2px}

/* Kepesantrenan */
.pesantren{color:#fff;background:radial-gradient(800px 360px at 10% 0%,rgba(212,160,23,.2),transparent 60%),linear-gradient(135deg,var(--navy),var(--indigo))}
.pesantren .judul h2{color:#fff}
.pesantren .judul p{color:#cfd8ee}
.kitab{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.kitab div{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:16px;padding:22px}
.kitab i{color:var(--emas-terang);font-size:20px;margin-bottom:10px;display:block}
.kitab b{display:block;font-weight:600;font-size:16px}
.kitab span{font-size:13.5px;color:#cfd8ee;font-weight:300}

/* Iklan */
.iklan{padding:56px 0 0}
.slot{display:flex;align-items:center;gap:20px;background:#fff;border:1px dashed #c3c9d9;border-radius:18px;padding:22px 28px}
.slot .ikon{width:58px;height:58px;flex:none;border-radius:16px;display:grid;place-items:center;background:linear-gradient(135deg,var(--royal),var(--indigo));color:#fff;font-size:24px}
.slot b{color:var(--navy);font-weight:600}

/* CTA */
.cta{padding:96px 0}
.cta .kotak{border-radius:28px;padding:64px 40px;text-align:center;color:#fff;background:radial-gradient(700px 300px at 50% -20%,rgba(212,160,23,.3),transparent 60%),linear-gradient(135deg,var(--navy),var(--indigo))}
.cta h2{font-size:clamp(28px,3.6vw,42px);margin-bottom:14px}
.cta p{color:#cfd8ee;font-weight:300;max-width:520px;margin:0 auto 30px}
.cta .tombol{justify-content:center}

/* Footer */
footer{background:var(--navy);color:#cfd8ee;border-top:3px solid var(--emas);padding:56px 0 0;font-size:14px}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding-bottom:40px}
footer .logo{margin-bottom:14px}
footer p{margin:0;max-width:340px;font-weight:300}
footer h4{color:#fff;font-size:15px;margin:0 0 14px;font-weight:600}
footer ul{list-style:none;margin:0;padding:0}
footer li{margin-bottom:8px}
footer li a{text-decoration:none;transition:color .2s}
footer li a:hover{color:var(--emas-terang)}
.hak{border-top:1px solid rgba(255,255,255,.1);text-align:center;padding:20px 0}

/* Tablet */
@media(max-width:960px){
  .hero{padding:72px 0 130px}
  .hero .wrap,.tentang .wrap{grid-template-columns:1fr;gap:40px}
  .stat .wrap>div{grid-template-columns:repeat(2,1fr);row-gap:22px}
  .stat article:nth-child(3){border-left:0}
  .kitab{grid-template-columns:repeat(2,1fr)}
  .fgrid{grid-template-columns:1fr 1fr}
  .fgrid>div:first-child{grid-column:1/-1}
  section{padding:72px 0}
}
/* HP */
@media(max-width:720px){
  .burger{display:block}
  nav{position:absolute;left:0;right:0;top:100%;background:var(--navy);border-bottom:1px solid rgba(255,255,255,.1);display:none;padding:10px 24px 18px}
  nav.buka{display:block}
  nav ul{flex-direction:column;align-items:stretch;gap:2px}
  nav a{display:block;padding:12px 14px}
  nav a.daftar{margin:8px 0 0;text-align:center}
  .grid2,.kitab{grid-template-columns:1fr}
  .jcard{padding:28px}
  .stat .wrap>div{padding:22px 6px}
  .stat strong{font-size:26px}
  .slot{flex-direction:column;text-align:center}
  .cta .kotak{padding:44px 22px}
  .fgrid{grid-template-columns:1fr}
  .hero .tombol .btn{flex:1;justify-content:center}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>

<header>
  <div class="bar">
    <a href="#beranda" class="logo"><img src="data:image/jpeg;base64," alt="Logo PeTIK Jombang" width="44" height="44"> PeTIK Jombang</a>
    <button class="burger" aria-label="Buka menu" aria-expanded="false" aria-controls="menu"><i class="fa-solid fa-bars"></i></button>
    <nav id="menu" aria-label="Navigasi utama">
      <ul>
        <li><a href="#tentang">Tentang</a></li>
        <li><a href="#jurusan">Jurusan</a></li>
        <li><a href="#kepesantrenan">Kepesantrenan</a></li>
        <li><a href="#kontak">Contact</a></li>

        </ul>
      </div>
    </div>
    <div class="hak">Copyright &copy; 2023 Programming PeTIK. All Rights Reserved</div>
  </div>
</footer>

<script>
  const tombol=document.querySelector('.burger'),menu=document.getElementById('menu');
  tombol.addEventListener('click',()=>{const buka=menu.classList.toggle('buka');tombol.setAttribute('aria-expanded',buka)});
  menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu.classList.remove('buka');tombol.setAttribute('aria-expanded',false)}));
</script>
